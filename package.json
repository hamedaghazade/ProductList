{
  "name": "product-list-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start:prod --workspace=apps/backend",
    "prisma:generate": "npm --prefix apps/backend run prisma:generate",
    "prisma:migrate": "npm --prefix apps/backend run prisma:migrate:dev",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/telegram-web-app": "^9.6.0",
    "jest": "^30.5.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "express-rate-limit": "^8.7.0"
  }
}
