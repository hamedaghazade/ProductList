datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum BarcodeType {
  EAN13
  CODE128
}

model Product {
  id                 String      @id @default(uuid())
  name               String      @db.VarChar(150)
  quantityPerPackage Int         @map("quantity_per_package")
  price              Decimal     @db.Decimal(14, 2)
  barcode            String      @db.VarChar(64)
  barcodeType        BarcodeType @default(EAN13) @map("barcode_type")
  telegramUserId     String      @map("telegram_user_id") @db.VarChar(64)
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@unique([telegramUserId, barcode], name: "unique_user_barcode")
  @@index([telegramUserId])
  @@index([name])
  @@index([barcode])
  @@map("products")
}